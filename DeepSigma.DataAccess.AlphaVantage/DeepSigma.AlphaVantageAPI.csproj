<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>DeepSigma.AlphaVantage</Title>
    <Version>4.0.0</Version>
    <PackageReleaseNotes>4.0.0: on DeepSigma.DataAccess.Web 4.0.0. Alpha Vantage's refusals in an HTTP 200 (Information, Note, Error Message) now throw InvalidOperationException on every JSON call instead of parsing to an empty result (AlphaVantageResponseGuard, moved here from the web package's JsonResponseGuards.AlphaVantage).</PackageReleaseNotes>
    <Authors>DeepSigma LLC</Authors>
    <Description>C# library for interacting with Alpha Vantage API.</Description>
    <PackageProjectUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.AlphaVantageAPI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.AlphaVantageAPI</RepositoryUrl>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <PackageIcon>Assets\DeepSigma.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeepSigma.DataAccess.Web" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\DeepSigma.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
